<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/edit_driver_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Create Driver Account"
        android:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Delete icon on top right -->
    <ImageView
        android:id="@+id/btn_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/delete"
        android:contentDescription="Delete"
        app:layout_constraintTop_toTopOf="@id/edit_driver_toolbar"
        app:layout_constraintBottom_toBottomOf="@id/edit_driver_toolbar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable form -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/edit_driver_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSaveDriver">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/label_driver_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"/>
            <EditText
                android:id="@+id/editDriverName"
                android:hint="Driver Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_search"
                android:inputType="none" />

            <TextView
                android:id="@+id/label_dob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DOB"/>
            <EditText
                android:id="@+id/editDOB"
                android:hint="Driver Date of Birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_driver_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone"/>
            <EditText
                android:id="@+id/editDriverPhone"
                android:hint="Driver Phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_phone2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EmergencyPhone"/>
            <EditText
                android:id="@+id/editDriverPhone2"
                android:hint="Driver Emergency Phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_currentAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Address"/>
            <EditText
                android:id="@+id/editDriverCurrentAddress"
                android:hint="Driver Current Address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:minLines="2"
                android:maxLines="3"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_address2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Native Address"/>
            <EditText
                android:id="@+id/editDriverNativeAddress"
                android:hint="Driver Native Address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:minLines="2"
                android:maxLines="3"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_aadhaar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aadhaar"/>
            <EditText
                android:id="@+id/editAadhaar"
                android:hint="Aadhaar Number"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_licence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Licence"/>
            <EditText
                android:id="@+id/editLicenceNumber"
                android:hint="Licence Number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_experience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Experience"/>
            <EditText
                android:id="@+id/editDrivingExperience"
                android:hint="Driving Experience (Years)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note"/>
            <EditText
                android:id="@+id/editNote"
                android:hint="Note for Driver Profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:minLines="3"
                android:maxLines="6"
                android:layout_marginTop="12dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Status"
                android:checked="true" />

        </LinearLayout>

    </ScrollView>

    <!-- Fixed Bottom Button -->
    <Button
        android:id="@+id/btnSaveDriver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Driver"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
