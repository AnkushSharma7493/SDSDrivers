<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".driver.ui.fragements.driver.CommissionPaymentFragment">

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/black">

            <ImageView
                android:id="@+id/icon_filter_duty"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:src="@drawable/tune"
                android:contentDescription="Expand Duty Details"
                android:padding="1dp"
                app:tint="@android:color/white"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>


            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Duty Date"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:singleLine="true"
                android:layout_marginStart="20dp"/>

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Duty Charges"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textStyle="bold"
                android:layout_marginStart="3dp" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:text="Commission"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textStyle="bold"
                android:layout_marginStart="3dp" />
        </LinearLayout>
        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />


        <!-- Footer -->
        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#EEEEEE"
            android:padding="8dp">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay ₹0"
                android:drawableStart="@drawable/upi_pay_white"
                android:drawablePadding="8dp"
                android:padding="8dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/white" />


            <TextView
                android:id="@+id/tvTotalCharges"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:layout_marginStart="60dp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvTotalCommission"
                android:layout_width="100dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:layout_marginStart="20dp"/>
        </LinearLayout>

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>