<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Toolbar with title, back, and save icon -->
<!--    <androidx.appcompat.widget.Toolbar-->
<!--        android:id="@+id/duty_toolbar"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="?attr/actionBarSize"-->
<!--        android:background="?attr/colorPrimary"-->
<!--        android:title="Duty Details"-->
<!--        android:titleTextColor="@android:color/white"-->
<!--        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"-->
<!--        app:navigationIcon="@drawable/back"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent" />-->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/duty_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/black"
        android:title="Duty Details"
        android:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/back"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Scrollable Form Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/duty_toolbar"
        app:layout_constraintBottom_toTopOf="@id/button_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:id="@+id/label_customer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Name"/>
            <EditText
                android:id="@+id/customer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:hint="Customer Name" />

            <TextView
                android:id="@+id/label_customer_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Phone"/>
            <EditText
                android:id="@+id/customer_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:hint="Customer Phone" />

            <TextView
                android:id="@+id/label_customer_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Address"/>
            <EditText
                android:id="@+id/customer_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:hint="Customer Address" />
            <TextView
                android:id="@+id/label_charges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Charges"/>
            <EditText
                android:id="@+id/charges"
                android:hint="Duty Charges"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/label_actual_charges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Actual Charges"/>
            <EditText
                android:id="@+id/actual_charges"
                android:hint="Duty Actual Charges"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/label_commison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Commision Amount"/>
            <EditText
                android:id="@+id/commission"
                android:hint="Commission"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/label_duty_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Date"/>
            <EditText
                android:id="@+id/dutyDate"
                android:hint="Duty Date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/label_duty_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Reporting Time"/>
            <EditText
                android:id="@+id/dutyTime"
                android:hint="Duty Time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />


            <TextView
                android:id="@+id/label_start_duty_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Start Time"/>
            <EditText
                android:id="@+id/startDutyTime"
                android:hint="Duty Time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_complete_duty_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Complete Time"/>
            <EditText
                android:id="@+id/completeDutyTime"
                android:hint="Duty Time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_duty_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duty Status"/>

            <EditText
                android:id="@+id/dutyStatus"
                android:hint="Duty Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/label_commisson_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Commisson Status"/>

            <EditText
                android:id="@+id/commissonStatus"
                android:hint="Commisson Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/button_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/dutyDetailsButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="1dp"
        android:gravity="center">
        <Button
            android:id="@+id/btnPayCommission"
            android:layout_width="match_parent"
            android:backgroundTint="@color/common_google_signin_btn_text_light"
            android:textColor="@android:color/white"
            android:layout_height="wrap_content"
            android:text="Pay Commisson"
            android:visibility="visible" />
    </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
